<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
    <field name="arch" type="xml">
      <!-- HT02687: Excedente antes de Lote/Nº de serie -->
      <field name="lot_id" position="before">
        <field name="is_carry_type" column_invisible="True" />
        <field name="burden_partner_id" invisible="not is_carry_type" optional="hide" />
        <field name="surplus" invisible="not is_carry_type" optional="show" />
      </field>
    </field>
  </record>
</odoo>
